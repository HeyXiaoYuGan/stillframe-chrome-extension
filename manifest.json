{
  "manifest_version": 3,
  "name": "定格 StillFrame",
  "version": "1.0.3",
  "minimum_chrome_version": "109",
  "description": "在本地扫描网页图片与媒体，支持截图、打包及 Pinterest、抖音、B站保存工具。",
  "key": "",
  "permissions": [
    "contextMenus",
    "declarativeNetRequestWithHostAccess",
    "downloads",
    "notifications",
    "offscreen",
    "scripting",
    "storage",
    "webRequest"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://onlyfans.com/*",
        "https://*.onlyfans.com/*"
      ],
      "js": [
        "onlyfans-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "i18n.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "定格 StillFrame",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
